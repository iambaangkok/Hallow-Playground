{
  // Worker script + static assets, on route iambaangkok.dev/playground*.
  // The route keeps the path prefix, so Vite `base` is /playground/ and the build lands in
  // dist/playground/ while assets serve from dist/. Change one, change the other.
  // The build also copies index.html to dist/ root: SPA fallback serves /index.html, which is how
  // invite links like /playground/ABCDE reach the app.
  // `name` must match the Worker name in the Cloudflare dashboard, and renaming it would orphan the
  // Durable Objects that hold every Playground's Pumpkins. The old /hallow-playground path redirects.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hallow-playground",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "iambaangkok.dev/playground*", "zone_name": "iambaangkok.dev" },
    { "pattern": "iambaangkok.dev/hallow-playground*", "zone_name": "iambaangkok.dev" }
  ],
  // "1" serves a closed page on every path and refuses all API and WebSocket traffic. Set to "0" to reopen.
  "vars": { "CLOSED": "1" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "PLAYGROUND", "class_name": "PlaygroundRoom" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlaygroundRoom", "Directory"] }]
}
